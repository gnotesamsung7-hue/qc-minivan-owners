{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        "meta":   { ".write": "auth != null && !data.exists()" },
        "members": {
          "$uid": { ".write": "auth != null && auth.uid === $uid" }
        },
        "routes": { ".write": "auth != null" },
        "pins":   { ".write": "auth != null" },
        "floor":  { ".write": "auth != null" },
        "ptt":    { ".write": "auth != null" }
      }
    }
  }
}
