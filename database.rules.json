{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        "meta":   { ".write": "auth != null && !data.exists()" },
        "members": {
          "$uid": { ".write": "auth != null && auth.uid === $uid" }
        },
        "pics": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val().length < 30000"
          }
        },
        "chat": {
          "$msg": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.child('uid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 300"
          }
        },
        "routes": { ".write": "auth != null" },
        "pins":   { ".write": "auth != null" },
        "floor":  { ".write": "auth != null" },
        "ptt":    { ".write": "auth != null" }
      }
    }
  }
}
